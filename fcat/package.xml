<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fcat</name>
  <version>0.14.0</version>
  <description>
    ROS 2 node exposing the fastcat command-and-control layer over EtherCAT,
    built on SOEM, jsd and fastcat, as ROS topics and services.
  </description>

  <url type="repository">https://github.com/nasa-jpl/fcat</url>
  <url type="bugtracker">https://github.com/nasa-jpl/fcat/issues</url>

  <maintainer email="daniel.pastor.moreno@jpl.nasa.gov">Daniel Pastor</maintainer>
  <maintainer email="kwehage@jpl.nasa.gov">Kristopher Wehage</maintainer>

  <author>Alex Brinkman</author>
  <author email="bowkett@jpl.nasa.gov">Joseph Bowkett</author>
  <author>Justin Morris</author>
  <author>Daniel Loret de Mola Lemus</author>
  <author email="prestonr@jpl.nasa.gov">Preston Rogers</author>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>python3-cogapp</build_depend>

  <depend>rclcpp</depend>
  <depend>rcutils</depend>
  <depend>fcat_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_clang_format</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
